FROM nginx:alpine

# Desativa completamente qualquer cache HTTP/Cloudflare para entregas de APK sempre atualizadas
RUN printf 'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    root /usr/share/nginx/html;\n\
    location / {\n\
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;\n\
        add_header Pragma "no-cache" always;\n\
        add_header Expires "0" always;\n\
        try_files $uri $uri/ =404;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

COPY zyveron-play-tv.apk /usr/share/nginx/html/app.apk
RUN cp /usr/share/nginx/html/app.apk /usr/share/nginx/html/zyveron-play-tv.apk && \
    cp /usr/share/nginx/html/app.apk /usr/share/nginx/html/zyveron-v22.apk && \
    cp /usr/share/nginx/html/app.apk /usr/share/nginx/html/zyveron-play-v22.apk && \
    cp /usr/share/nginx/html/app.apk /usr/share/nginx/html/zyveron-play-v4.apk
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
