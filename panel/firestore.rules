rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. APARELHOS (MACS)
    // Permite que uma TV consulte SOMENTE o seu próprio MAC diretamente (get).
    match /devices/{macAddress} {
      allow get: if true;
      allow list, write: if true;
    }

    // 2. SERVIDORES & DNS
    // Permite que as TVs consultem o endpoint do servidor vinculado
    match /servers/{serverId} {
      allow get: if true;
      allow list, write: if true;
    }

    // 3. AVISOS E NOTIFICAÇÕES NA TV
    // Permite que a TV leia os comunicados ativos
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. CONTAS E AUDITORIA DE CRÉDITOS
    match /users/{userId} {
      allow read, write: if true;
    }

    match /credit_logs/{logId} {
      allow read, write: if true;
    }

    // 5. ATUALIZAÇÕES DO APLICATIVO (OTA) & CONFIGURAÇÕES GERAIS
    // Permite que o aplicativo na TV consulte a versão oficial mais recente
    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /app_updates/{updateId} {
      allow read, write: if true;
    }
  }
}
