# CREDENCIAIS MASTER (SUPERADMIN)
# =============================================
# Email do administrador master
NEXT_PUBLIC_MASTER_EMAIL=admin@zyveronplay.com

# Hash bcrypt da senha master (gerar com: node -e "const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('SUA_SENHA', 10))")
# Exemplo abaixo é hash de: Adm0418$
MASTER_PASSWORD_BCRYPT=$2a$10$xyz...

# FIREBASE CONFIG (Público - OK expor)
# =============================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD_keI8HrRiu2zmXXi0JybhBFBu7xn8cbw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zyveronplay.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zyveronplay
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zyveronplay.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# FIREBASE ADMIN SDK (PRIVADO - NÃO COMMITAR!)
# =============================================
# Obter em: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=zyveronplay
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@zyveronplay.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# CONFIGURAÇÕES OPCIONAIS
# =============================================
# Modo de desenvolvimento (opcional)
# NODE_ENV=development

# URL da API (opcional, padrão: window.location.origin)
# NEXT_PUBLIC_API_URL=https://tvplay.loja-am.top
