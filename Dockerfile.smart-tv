# 1. Base Node para compilação do Vite
FROM node:20-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY smart-tv/package.json smart-tv/pnpm-lock.yaml* ./
RUN pnpm install

COPY smart-tv/ .
RUN pnpm run build

# 2. Servidor Nginx de produção ultra-leve (< 10MB RAM na VPS)
FROM nginx:alpine AS runner
COPY --from=builder /app/dist /usr/share/nginx/html
COPY smart-tv/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
