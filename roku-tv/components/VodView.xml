<?xml version="1.0" encoding="utf-8" ?>
<component name="VodView" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/api.brs" />
  <script type="text/brightscript" uri="pkg:/components/VodView.brs" />

  <interface>
    <field id="accountData" type="assocarray" onChange="OnAccountDataChange" />
    <field id="viewParams" type="assocarray" onChange="OnViewParamsChange" />
  </interface>

  <children>
    <!-- Header -->
    <Rectangle width="1920" height="90" color="#0e131f" translation="[0, 0]" />
    <Label text="ZYVERON PLAY" font="font:MediumBoldSystemFont" color="#06b6d4" translation="[60, 28]" />
    <Label id="lblSectionTitle" text="|  FILMES" font="font:MediumSystemFont" color="#ffffff" translation="[240, 28]" />
    <Label text="Pressione [VOLTAR] para a Home" font="font:SmallSystemFont" color="#64748b" translation="[1550, 32]" />

    <!-- Barra Superior de Categorias -->
    <LabelControl id="categoryRow" font="font:SmallBoldSystemFont" color="#94a3b8" focusedColor="#06b6d4" translation="[60, 110]" />

    <!-- Grid de Pôsteres (5 colunas) -->
    <PosterGrid id="posterGrid" basePosterSize="[240, 360]" itemSpacing="[24, 24]" translation="[60, 160]" numColumns="6" numRows="2" />

    <!-- Painel Inferior de Detalhes do Item Focado -->
    <Group translation="[60, 940]">
      <Rectangle width="1800" height="100" color="#121826" />
      <Label id="lblFocusedTitle" text="Selecione um título" font="font:MediumBoldSystemFont" color="#ffffff" translation="[30, 20]" />
      <Label id="lblFocusedMeta" text="Pressione [OK] para assistir" font="font:SmallSystemFont" color="#06b6d4" translation="[30, 58]" />
    </Group>

    <!-- Indicador de Carregamento -->
    <Label id="lblLoading" text="Carregando catálogo..." font="font:MediumSystemFont" color="#06b6d4" horizAlign="center" width="1920" translation="[0, 500]" visible="false" />
  </children>
</component>
